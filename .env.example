# Copy to .env. Keep comments on their own line (a comment after an empty value becomes the value).

# --- secrets ---
# https://developer.usajobs.gov/apirequest/
USAJOBS_API_KEY=
# Hugging Face fine-grained token, write access to this dataset only
HF_TOKEN=

# --- identity ---
# the email you registered with USAJOBS
USAJOBS_USER_AGENT=

# --- publishing ---
HF_DATASET_REPO=cccc864/usajobs-postings
HF_DATASET_PRIVATE=true         # publish refuses a PUBLIC dataset unless this is false

# --- scope ---
JOB_SERIES=2210                # semicolon-separated, e.g. "2210;0854;1550"
SNAPSHOT=live                  # "live" = call the API; "archive-2024-11-12" = use that raw folder

# --- models ---
EMBED_MODEL=Xenova/bge-small-en-v1.5  # options: usajobs_datapull/embedders.py
